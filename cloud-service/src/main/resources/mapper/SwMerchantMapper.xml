<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SwMerchantMapper">

    <select id="getMerchantByName" resultType="com.example.entity.SwMerchant">
        SELECT * FROM sw_merchant WHERE merchant_name = #{id}

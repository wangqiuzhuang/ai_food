<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SwCommentsMapper">

    <select id="queryCommentsByUserId" resultType="com.example.entity.SwComments">
        select * from sw_comments WHERE user_id = #{userId}
    </select>
    <select id="queryCommentsByFoodIdAndMerchantId" resultType="com.example.entity.SwComments">
        select * from sw_comments WHERE food_id = #{foodId} and merchant_id = #{merchantId}

    </select>
</mapper>
